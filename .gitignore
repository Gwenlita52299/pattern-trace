# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*

# Node (Next.js)
node_modules/
.next/
out/
dist/

# 密钥：绝不入库（.env / .env.*.local 可能含数据库口令、API key）
# 注意：不匹配 .env.example，模板样例保留入库
.env
.env.local
.env.development
.env.production
.env.*.local

# 生成的报告输出（output/ 是程序运行产物，源码在 docs/）
output/

# 生产运行手册：含真实生产配置（DeepSeek key、live 环境口令示例），不入库
# （与 .env 同类敏感文档，源码/说明见 README 的 docs 索引）
docs/production-runbook.md

# 本地 Claude Code 配置（本地私有，不检入，见 CLAUDE.md 加载层级 Local 层）
.claude/settings.local.json

# 生成缓存 / 构建产物
# .cache/ = embeddings 向量缓存等运行时生成物；*.tsbuildinfo = TypeScript 构建缓存
.cache/
*.tsbuildinfo

# OS / 编辑器
.DS_Store
.idea/
.vscode/

# 本地演示稿（不入库）
demos/

# 种子数据（与 DB 同类：本地运行数据，不入库；CSV 源自外部归因清单 ~/Downloads）
# 例外：graphormer_v2/derived 是检索查询侧运行时依赖（graphormer.py 顶层
# np.load），单测和 docker 运行时都需要，必须入库（~31MB，单文件 <=17MB）
ingest/seed/*
!ingest/seed/graphormer_v2/
ingest/seed/graphormer_v2/*
!ingest/seed/graphormer_v2/derived/
# parquet 原始语料（594MB edges / 97MB nodes）仍不入库：仅 ingest 建 DB 用

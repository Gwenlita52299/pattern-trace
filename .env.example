# Required — no weak default allowed (IF-04)
JWT_SECRET=change-me-to-a-long-random-string

# 首个 admin 账号，首次启动时 seed（backend-api-spec §users）
# 不配置则容器内没有任何可登录账号
BOOTSTRAP_ADMIN_EMAIL=admin@patterntrace.local
BOOTSTRAP_ADMIN_PASSWORD=

# Optional overrides
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:30b-a3b
LLM_BASE_URL=http://localhost:11434
# LLM_API_KEY=
# mock provider 场景脚本（端到端测试用）：valid_high | valid_no_match |
# invalid_json_then_valid | invalid_evidence_all_retries
# LLM_MOCK_SCENARIO=valid_high

# 分析数据源：fixture（内置演示子图，离线可用）| live（Esplora 公网 API）
GRAPH_DATA_MODE=fixture
# ESPLORA_API_URL=https://mempool.space/api
# 匿名演示白名单地址 CSV；留空则使用 fixture 内置 seed
# DEMO_SEEDS=

# 前后端分域部署时必开（Cookie 将带 Secure + SameSite=None）；本地保持 false
# COOKIE_SECURE=true
# CORS 显式白名单 CSV（默认放行 localhost:3000；生产注入正式前端域名）
# CORS_ORIGINS=https://your-frontend.vercel.app

# 阶段2 ingest（默认值见 backend/core/config.py，按需覆盖）
# LAZARUS_DATA_DIR=/Users/gwenlita/Documents/bybit_rust/golden/python
# INGEST_SYNTH_POSITIVES=1500
# NEGATIVE_RATIO=3
# EMBEDDING_PROVIDER=stub
# EMBEDDING_CACHE_DIR=.cache/embeddings

# Required — no weak default allowed (IF-04)
# issue #27：运行时校验 ≥32 字符、拒绝占位值与低熵字符串；示例值需替换后才能启动
JWT_SECRET=<generate-with-openssl-rand-hex-32>

# 首个 admin 账号，首次启动时 seed（backend-api-spec §users）
# 不配置则容器内没有任何可登录账号
BOOTSTRAP_ADMIN_EMAIL=admin@patterntrace.local
BOOTSTRAP_ADMIN_PASSWORD=

# LLM 判断：生产/默认走 deepseek（需 LLM_API_KEY）；离线演示可设 LLM_PROVIDER=mock
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=
# mock provider 场景脚本（端到端测试用）：valid_high | valid_no_match |
# invalid_json_then_valid | invalid_evidence_all_retries
# LLM_MOCK_SCENARIO=valid_high

# 本地推理（可选）：docker compose --profile local-llm up 拉起 llama.cpp。
# 首启从 HuggingFace 下载 ~16GB 模型（unsloth UD-Q4_K_M 量化），请预留磁盘与时间；
# 本地已有 HF 缓存时可在 compose 里把 ~/.cache/huggingface bind-mount 进容器复用。
# 切换后取消以下注释（LLM_MODEL 必须与 llama-server --alias 一致，缓存 key 含 model）：
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=qwen3.8-27b
# LLM_BASE_URL=http://llamacpp:8080/v1

# 分析数据源：fixture（内置演示子图，离线可用）| live（Esplora 公网 API）
GRAPH_DATA_MODE=fixture
# ESPLORA_API_URL=https://mempool.space/api
# 匿名演示白名单地址 CSV；留空则使用 fixture 内置 seed
# DEMO_SEEDS=

# 前后端分域部署时必开（Cookie 将带 Secure + SameSite=None）；本地保持 false
# COOKIE_SECURE=true
# CORS 显式白名单 CSV（默认放行 localhost:3000；生产注入正式前端域名）
# CORS_ORIGINS=https://your-frontend.vercel.app

# 阶段2 ingest（默认值见 backend/core/config.py，按需覆盖）
# LAZARUS_DATA_DIR=/Users/gwenlita/Documents/bybit_rust/golden/python
# INGEST_SYNTH_POSITIVES=1500
# NEGATIVE_RATIO=3
# EMBEDDING_PROVIDER=stub            # stub | openai_compat
# EMBEDDING_CACHE_DIR=.cache/embeddings
# openai_compat（OpenAI 兼容 /embeddings，OpenRouter / SiliconFlow 等）：
# EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m
# EMBEDDING_DIM=1024
# EMBEDDING_API_KEY=

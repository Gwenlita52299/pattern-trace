FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml uv.lock ./
# issue #82：graphormer-online 组（torch/transformers 4.x）使在线 ego 前向
# 在 worker 生效；未安装时自动回退 ego 查表/hybrid（retriever 三级链）
RUN pip install --no-cache-dir uv && uv sync --frozen --no-dev --extra graphormer-online
# uv sync 装到 /app/.venv，不加入 PATH 则 alembic/uvicorn/arq 命令找不到
ENV PATH="/app/.venv/bin:$PATH"

COPY backend/ backend/
# issue #78：seed_kb_fixture 复用 ingest.common（content_hash/upsert_rows）；
# 只复制 py 源文件——seed 语料 parquet/npz 不进镜像（运行时经 volume 挂载）
COPY ingest/*.py ingest/
COPY alembic.ini ./
COPY migrations/ migrations/
COPY workers/ workers/
# FixtureTxProvider 与 /demo/addresses 运行时读取 infra/fixtures/demo_txs.json
COPY infra/ infra/

EXPOSE 8000
CMD ["uvicorn", "backend.api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
